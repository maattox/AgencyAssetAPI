{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    // Matches Azure App Service: no User/Password and no Authentication=.
    // AssetDataAccess injects an AccessToken via DefaultAzureCredential (az login / VS).
    // Do not use Authentication=Active Directory Default with Microsoft.Data.SqlClient 7.x
    // (requires Extensions.Azure, which can throw AmbiguousMatchException).
    "DefaultConnection": "Server=tcp:YOUR-SERVER.database.windows.net,1433;Initial Catalog=AgencyAssetDB;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "SpecialValues": {
    "MaxDaysSinceLastAudit": 90, // Maximum number of days since the last audit before an asset is considered overdue for audit
    "StorageAccountName": "myagencyassetstore"
  },
  "Authorization": {
    "ApiKey": "your-local-dev-api-key",
    "ApiKeyFallback": ""
  }
}
